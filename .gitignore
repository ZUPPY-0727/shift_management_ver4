# Local runtime data: publish the placeholder only, never the SQLite DB or backups.
/instance/*
!/instance/.gitkeep
/data/
/backups/
/exports/
/uploads/
/private/
/secrets/
/credentials/

# SQLite files, including journals/WAL/SHM, copies and exported dumps.
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.dump
*.sqlitedump

# Environment files and credentials. Examples must contain placeholders only.
.env
.env.*
!.env.example
.flaskenv
.flaskenv.*
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519
credentials*.json
service-account*.json
secrets*.json
.aws/
.ssh/

# Python, pytest and local environments.
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
.conda/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
build/
dist/
*.egg-info/

# Logs, archives and local temporary files may contain personal information.
*.log
logs/
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
*.tmp
*.temp
*.bak
*.backup
*.old
*~

# OS/editor files. Do not ignore application source, templates or public assets.
.DS_Store
Thumbs.db
.vscode/
.idea/

